{
  "name": "bassoontracker",
  "version": "0.5.0.8",
  "description": "Old School Amiga mod and xm tracker in plain javascript",
  "repository": "https://github.com/steffest/BassoonTracker",
  "author": "Steffest",
  "license": "MIT",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test:features": "node --experimental-vm-modules --test tests/featureFlags.test.cjs",
    "test:debug-logging": "node --experimental-vm-modules --test tests/debugLogging.test.cjs",
    "test:debug-logging:browser": "node tests/debugLogging.browser.mjs",
    "test:mod-export": "node --experimental-vm-modules --test tests/modExport.test.cjs",
    "test:notes": "node --experimental-vm-modules --test tests/note.test.cjs",
    "test:notes:browser": "node tests/note.browser.mjs",
    "test:scopes": "node --experimental-vm-modules --test tests/scope.test.cjs",
    "test:scopes:browser": "node tests/scope.browser.mjs",
    "test:audio-buffer": "node --experimental-vm-modules --test tests/sampleBuffer.test.cjs",
    "test:audio-buffer:browser": "node tests/sampleBuffer.browser.mjs",
    "test:pattern-cache:browser": "node tests/patternRowCache.browser.mjs",
    "deploy": "VITE_OUTDIR=live vite build",
    "skin": "node skin/generate.js"
  },
  "optionalDependencies": {
    "vite": "^6.3.6"
  }
}
